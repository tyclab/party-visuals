  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/tyclab/party-visuals",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyclab/party-visuals.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "socket.io": "^4.8.3"
  },
  "nodecg": {
